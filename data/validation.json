{
  "_comment": "Правила проверки слоёв в data/processed для scripts/validate_data.py. Адаптировано под проект Уфа (Зарядные станции).",
  "crs": "EPSG:4326",
  "bbox": [55.5, 54.4, 56.3, 55.0],
  "max_file_mb": 10,
  "layers": {
    "boundary":          {"geometry": ["Polygon", "MultiPolygon"], "min_count": 1},
    "districts":         {"geometry": ["Polygon", "MultiPolygon"], "min_count": 1, "id": ["osm_type", "osm_id"], "required": ["name"]},
    "charging_stations": {"geometry": ["Point", "MultiPoint"], "min_count": 1, "id": ["osm_type", "osm_id"], "required": ["amenity"]},
    "malls":             {"geometry": ["Point", "Polygon"], "min_count": 1, "id": ["osm_type", "osm_id"]},
    "parking":           {"geometry": ["Point", "Polygon", "MultiPolygon"], "min_count": 1, "id": ["osm_type", "osm_id"]},
    "offices":           {"geometry": ["Point", "Polygon"], "min_count": 1, "id": ["osm_type", "osm_id"]}
  }
}
